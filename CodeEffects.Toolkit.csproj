<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>1.0.1.17</Version>
    <Authors>Code Effects Software</Authors>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Code Effects Toolkit</Title>
    <Product>Code Effects Toolkit</Product>
    <Description>A toolkit used in Code Efefcts demo projects</Description>
    <Copyright>Code Effects Software © 2026</Copyright>
    <PackageProjectUrl>https://codeeffects.com</PackageProjectUrl>
    <PackageIcon>Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/codeeffects-software/Toolkit</RepositoryUrl>
    <PackageReleaseNotes>This is the initial release of the toolkit</PackageReleaseNotes>
    <PackageTags>code effects codeeffects toolkit html demo</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeEffects.Rule.Common" Version="6.0.3.23" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
